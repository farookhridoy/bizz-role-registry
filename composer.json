{
    "name": "bizzsol/role-registry",
    "description": "Functional role keys bound to roles (role_bindings), userIs() helper and registry shared by the ERP apps.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0||^11.0||^12.0",
        "illuminate/database": "^10.0||^11.0||^12.0",
        "spatie/laravel-permission": "^6.0"
    },
    "autoload": {
        "psr-4": {"Bizzsol\\RoleRegistry\\": "src/"},
        "files": ["src/helpers.php"]
    },
    "extra": {"laravel": {"providers": ["Bizzsol\\RoleRegistry\\RoleRegistryServiceProvider"]}},
    "minimum-stability": "stable"
}
